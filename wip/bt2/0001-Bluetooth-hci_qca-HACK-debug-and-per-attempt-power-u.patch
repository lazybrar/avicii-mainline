From 7b701502d020f9d1f05f8611120daf6cba00facd Mon Sep 17 00:00:00 2001
From: claude <211365301+lazybrar@users.noreply.github.com>
Date: Wed, 14 Oct 2026 17:19:00 +0530
Subject: [PATCH 1/7] Bluetooth: hci_qca: HACK debug and per-attempt power-up
 variants for WCN3990

Evidence (avicii live): serial1 tx:32 rx:0 brk:5, no uart/hci irqs, regulators
and pins match downstream (no BT gpio/clock in downstream wcn3990 node), so the
failure cannot be proven offline. Dump tiocm and vreg state around the power
pulses; vary OFF-pulse skip / settle delay / ON delay per retry (attempt%4).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/bluetooth/hci_qca.c | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 7089e9b63..7c8e80ea6 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -1401,6 +1401,24 @@ static inline void host_set_baudrate(struct hci_uart *hu, unsigned int speed)
 		hci_uart_set_baudrate(hu, speed);
 }
 
+/* HACK(bt2): per-attempt variants + state dump to decide the WCN3990 power-up failure */
+static int qca_hack_attempt;
+
+static void qca_hack_dump(struct hci_uart *hu, const char *what)
+{
+	struct qca_serdev *qcadev = serdev_device_get_drvdata(hu->serdev);
+	struct qca_power *pw = qcadev->bt_power;
+	int i;
+
+	bt_dev_info(hu->hdev, "HACK[%d] %s: tiocm=%#x", qca_hack_attempt, what,
+		    serdev_device_get_tiocm(hu->serdev));
+	for (i = 0; i < pw->num_vregs; i++)
+		bt_dev_info(hu->hdev, "HACK[%d]   %s en=%d uV=%d", qca_hack_attempt,
+			    pw->vreg_bulk[i].supply,
+			    regulator_is_enabled(pw->vreg_bulk[i].consumer),
+			    regulator_get_voltage(pw->vreg_bulk[i].consumer));
+}
+
 static int qca_send_power_pulse(struct hci_uart *hu, bool on)
 {
 	int timeout = CMD_TRANS_TIMEOUT;
@@ -1419,6 +1437,7 @@ static int qca_send_power_pulse(struct hci_uart *hu, bool on)
 	 */
 	bt_dev_dbg(hu->hdev, "sending power pulse %02x to controller", cmd);
 
+	qca_hack_dump(hu, on ? "before ON pulse" : "before OFF pulse");
 	serdev_device_write_flush(hu->serdev);
 	hci_uart_set_flow_control(hu, true);
 	ret = serdev_device_write_buf(hu->serdev, &cmd, sizeof(cmd));
@@ -1431,8 +1450,9 @@ static int qca_send_power_pulse(struct hci_uart *hu, bool on)
 	hci_uart_set_flow_control(hu, false);
 
 	/* Give to controller time to boot/shutdown */
+	qca_hack_dump(hu, on ? "after ON pulse" : "after OFF pulse");
 	if (on)
-		msleep(100);
+		msleep(qca_hack_attempt % 4 == 3 ? 400 : 100);
 	else
 		usleep_range(1000, 10000);
 
@@ -1798,6 +1818,13 @@ static int qca_regulator_init(struct hci_uart *hu)
 	case QCA_WCN3991:
 	case QCA_WCN3998:
 		/* Forcefully enable wcn399x to enter in to boot mode. */
+		qca_hack_attempt++;
+		if (qca_hack_attempt % 4 == 2 || qca_hack_attempt % 4 == 3)
+			msleep(300); /* HACK: regulators settle before pulse */
+		if (qca_hack_attempt % 4 == 0 || qca_hack_attempt % 4 == 3) {
+			bt_dev_info(hu->hdev, "HACK[%d] skipping OFF pulse", qca_hack_attempt);
+			break;
+		}
 		host_set_baudrate(hu, 2400);
 		ret = qca_send_power_pulse(hu, false);
 		if (ret)
-- 
