From c4ec883d2ba8dad67222e7146d1fa9b475fc4f72 Mon Sep 17 00:00:00 2001
From: claude <211365301+lazybrar@users.noreply.github.com>
Date: Wed, 14 Oct 2026 18:32:14 +0530
Subject: [PATCH 7/7] arm64: dts: qcom: sm7250-oneplus-avicii: Bluetooth is a
 WCN3991

The chip answers the version request with the WCN3991 layout (one extra
byte: 'QCA Version size mismatch len 15' as wcn3990), and the phone's
firmware set is crbtfw32.tlv/crnv32.bin (ROM 0x32, WCN3991).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm7250-oneplus-avicii.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7250-oneplus-avicii.dts b/arch/arm64/boot/dts/qcom/sm7250-oneplus-avicii.dts
index 53c4074cb..edcc7ec33 100644
--- a/arch/arm64/boot/dts/qcom/sm7250-oneplus-avicii.dts
+++ b/arch/arm64/boot/dts/qcom/sm7250-oneplus-avicii.dts
@@ -879,7 +879,7 @@ &uart5 {
 	status = "okay";
 
 	bluetooth {
-		compatible = "qcom,wcn3990-bt";
+		compatible = "qcom,wcn3991-bt";
 
 		vddio-supply = <&vreg_s4a_1p8>;
 		vddxo-supply = <&vreg_l14a_1p8>;
-- 
2.56.0

