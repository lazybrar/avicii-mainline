# Milestone 1 for OnePlus Nord (avicii): merged over arm64 defconfig
CONFIG_SM_GCC_7250=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
# gadget-only dwc3 (choice: replaces defconfig dual-role)
CONFIG_USB_DWC3_DUAL_ROLE=n
CONFIG_USB_DWC3_HOST=n
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# the bootloader leaves the APSS watchdog running (11 s bark); it must be serviced
CONFIG_QCOM_WDT=y

# Milestone 2: TLMM, internal UFS, PMIC reboot-mode (everything built in, no modules on device)
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM7250=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REBOOT_MODE=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# Thermal: TSENS + CPU frequency cooling
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_QCOM_TSENS=y

# PMICs: temp alarm, ADC, gpio-keys, pwrkey, RTC
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_INPUT_EVDEV=y

# GENI I2C (FIFO mode, bq27541 gauge in the battery pack)
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_POWER_SUPPLY=y

# Arch userspace: pacman sandboxes its downloader with Landlock
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,bpf"
