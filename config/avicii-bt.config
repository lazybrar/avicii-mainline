# Milestone 5 for OnePlus Nord (avicii): Bluetooth (WCN3990 on UART5, hci_qca).
# Merged over arm64 defconfig + avicii.config + avicii-audio.config. Everything built in.

# Bluetooth core and HCI UART transport
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y

# Serdev bus over the QUP GENI UART (uart5 at 0x894000)
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_QCOM_GENI_SE=y
