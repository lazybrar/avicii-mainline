# Display (OnePlus Nord avicii), merged over defconfig + avicii.config; all built in
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_SM_DISPCC_7250=y
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SAMSUNG_AMS644VK04=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_INTERCONNECT=y
# DRM_MSM depends on these being y when it is y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_SCHED=y
CONFIG_QCOM_MDT_LOADER=y
