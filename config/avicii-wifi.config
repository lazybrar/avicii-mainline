# Milestone 4 for OnePlus Nord (avicii): Wi-Fi (WCN3990, ath10k_snoc, wlan_pd in the modem).
# Merged over arm64 defconfig + avicii.config + avicii-display.config. Everything built in.

# Mailbox / signalling to the modem
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMP2P=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y

# Remote processor (MPSS through PAS), sysmon, glink over smem
CONFIG_REMOTEPROC=y
CONFIG_REMOTEPROC_CDEV=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y

# QRTR (IPCRTR channel of the glink edge), QMI, in-kernel protection domain mapper
CONFIG_NET=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PD_MAPPER=y

# rmtfs shared memory (userspace rmtfs talks to /dev/qcom_rmtfs_mem*)
CONFIG_QCOM_RMTFS_MEM=y

# Wi-Fi stack
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH10K_PCI=n
CONFIG_ATH10K_SDIO=n
CONFIG_ATH10K_USB=n
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_TRACING=n
CONFIG_ATH10K_DEBUGFS=n
CONFIG_ATH11K=n
CONFIG_ATH12K=n
CONFIG_ATH9K=n
CONFIG_ATH6KL=n
CONFIG_ATH5K=n

# Userspace crypto API used by iwd (wpa_supplicant works without)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_ARC4=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# Firmware comes from the root filesystem (Arch ships linux-firmware zstd-compressed).
# remoteproc has auto_boot=false for the mpss, and ath10k only asks for board data after
# the modem's wlan_pd has registered, so nothing requests firmware before the rootfs is mounted.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_EXTRA_FIRMWARE=""
