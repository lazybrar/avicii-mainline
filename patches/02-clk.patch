Subject: clk: qcom: SM7250 clock controllers

Combined diff of the following commits (base v7.3-rc7):

  - clk: qcom: Add Global Clock Controller (GCC) driver for SM7250
  - clk: qcom: rpmh: Add SM7250 rpmh clocks
  - clk: qcom: Add SM7250 display clock controller
  - clk: qcom: add SM7250 graphics clock controller driver
  - clk: qcom: Add SM7250 video clock controller driver
  - clk: qcom: videocc-sm7250: Match lito GDSC flags and add XO clock
  - clk: qcom: Add camera clock controller driver for SM7250

---
 drivers/clk/qcom/Kconfig          |   48 ++
 drivers/clk/qcom/Makefile         |    5 +
 drivers/clk/qcom/camcc-sm7250.c   | 2200 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/clk/qcom/clk-rpmh.c       |   24 +
 drivers/clk/qcom/dispcc-sm7250.c  | 1009 +++++++++++++++++++++++++
 drivers/clk/qcom/gcc-sm7250.c     | 2275 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/clk/qcom/gpucc-sm7250.c   |  366 ++++++++++
 drivers/clk/qcom/videocc-sm7250.c |  424 +++++++++++
 8 files changed, 6351 insertions(+)

diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index d1fc9bf87..f820b9648 100644
--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -1421,6 +1421,15 @@ config SM_CAMCC_8150
 	  Say Y if you want to support camera devices and functionality such as
 	  capturing pictures.
 
+config SM_CAMCC_7250
+	tristate "SM7250 Camera Clock Controller"
+	depends on ARM64 || COMPILE_TEST
+	select SM_GCC_7250
+	default m if ARCH_QCOM
+	help
+	  Support for the camera clock controller on SM7250 devices.
+	  Say Y if you want to support camera devices and camera functionality.
+
 config SM_CAMCC_8250
 	tristate "SM8250 Camera Clock Controller"
 	depends on ARM64 || COMPILE_TEST
@@ -1512,6 +1521,16 @@ config SM_DISPCC_7150
 	  Say Y if you want to support display devices and functionality such as
 	  splash screen.
 
+config SM_DISPCC_7250
+	tristate "SM7250 Display Clock Controller"
+	depends on ARM64 || COMPILE_TEST
+	depends on SM_GCC_7250
+	help
+	  Support for the display clock controller on Qualcomm Technologies, Inc
+	  SM7250 devices.
+	  Say Y if you want to support display devices and functionality such as
+	  splash screen.
+
 config SM_DISPCC_8250
 	tristate "SM8150/SM8250/SM8350 Display Clock Controller"
 	depends on ARM64 || COMPILE_TEST
@@ -1650,6 +1669,15 @@ config SM_GCC_7150
 	  Say Y if you want to use peripheral devices such as UART,
 	  SPI, I2C, USB, SD/UFS, PCIe etc.
 
+config SM_GCC_7250
+	tristate "SM7250 Global Clock Controller"
+	depends on ARM64 || COMPILE_TEST
+	select QCOM_GDSC
+	help
+	  Support for the global clock controller on SM7250 devices.
+	  Say Y if you want to use peripheral devices such as UART,
+	  SPI, I2C, USB, SD/UFS etc.
+
 config SM_GCC_MILOS
 	tristate "Milos Global Clock Controller"
 	depends on ARM64 || COMPILE_TEST
@@ -1801,6 +1829,15 @@ config SM_GPUCC_8150
 	  Say Y if you want to support graphics controller devices and
 	  functionality such as 3D graphics.
 
+config SM_GPUCC_7250
+	tristate "SM7250 Graphics Clock Controller"
+	depends on ARM64 || COMPILE_TEST
+	depends on SM_GCC_7250
+	help
+	  Support for the graphics clock controller on SM7250 devices.
+	  Say Y if you want to support graphics controller devices and
+	  functionality such as 3D graphics.
+
 config SM_GPUCC_8250
 	tristate "SM8250 Graphics Clock Controller"
 	depends on ARM64 || COMPILE_TEST
@@ -1945,6 +1982,17 @@ config SM_VIDEOCC_MILOS
 	  Say Y if you want to support video devices and functionality such as
 	  video encode/decode.
 
+config SM_VIDEOCC_7250
+	tristate "SM7250 Video Clock Controller"
+	depends on ARM64 || COMPILE_TEST
+	depends on SM_GCC_7250
+	select QCOM_GDSC
+	help
+	  Support for the video clock controller on Qualcomm Technologies, Inc
+	  SM7250 devices.
+	  Say Y if you want to support video devices and functionality such as
+	  video encode and decode.
+
 config SM_VIDEOCC_8150
 	tristate "SM8150 Video Clock Controller"
 	depends on ARM64 || COMPILE_TEST
