+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -1213,6 +1213,22 @@ static const struct qcom_pas_data sm8250_cdsp_resource = {
 	.ssctl_id = 0x17,
 };
 
+/* firmware lives on the rootfs: started by userspace (nord-modem) */
+static const struct qcom_pas_data sm7250_cdsp_resource = {
+	.crash_reason_smem = 601,
+	.firmware_name = "cdsp.mdt",
+	.pas_id = 18,
+	.auto_boot = false,
+	.proxy_pd_names = (char*[]){
+		"cx",
+		NULL
+	},
+	.load_state = "cdsp",
+	.ssr_name = "cdsp",
+	.sysmon_name = "cdsp",
+	.ssctl_id = 0x17,
+};
+
 static const struct qcom_pas_data sc8280xp_nsp0_resource = {
