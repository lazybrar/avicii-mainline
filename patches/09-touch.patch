diff --git a/drivers/input/touchscreen/goodix_gt9886.c b/drivers/input/touchscreen/goodix_gt9886.c
new file mode 100644
index 000000000..025fb1846
--- /dev/null
+++ b/drivers/input/touchscreen/goodix_gt9886.c
@@ -0,0 +1,387 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Goodix GT9886 I2C touchscreen driver
+ *
+ * Minimal driver: it reports multi-touch coordinates using the firmware and
+ * configuration already stored in the controller flash. Firmware/config
+ * upload, gestures and the in-display fingerprint events are not supported.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+
+#define GT9886_REG_COORD		0x4100
+#define GT9886_REG_PRODUCT_VER		0x452c
+#define GT9886_REG_DOZE_CTRL		0x30f0
+#define GT9886_REG_DOZE_STAT		0x3100
+#define GT9886_REG_REQUEST		0x6f6d
+
+#define GT9886_DOZE_ENABLE		0xcc
+#define GT9886_DOZE_DISABLE		0xaa
+#define GT9886_DOZE_CLOSED		0xbb
+
+#define GT9886_EVENT_TOUCH		BIT(7)
+#define GT9886_EVENT_REQUEST		BIT(6)
+
+#define GT9886_MAX_TOUCHES		10
+#define GT9886_COORD_SIZE		8
+/* status, touch count, coordinates, 16 bit checksum */
+#define GT9886_HEADER_SIZE		2
+#define GT9886_TRAILER_SIZE		2
+#define GT9886_MAX_FRAME		(GT9886_HEADER_SIZE + \
+					 GT9886_MAX_TOUCHES * GT9886_COORD_SIZE + \
+					 GT9886_TRAILER_SIZE)
+#define GT9886_PRODUCT_VER_LEN		72
+
+struct gt9886 {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[2];
+	struct touchscreen_properties prop;
+	u8 frame[GT9886_MAX_FRAME];
+};
+
+#define GT9886_I2C_RETRIES	5
+
+static int gt9886_read(struct gt9886 *ts, u16 reg, void *buf, u16 len)
+{
+	u8 addr[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msgs[] = {
+		{ .addr = ts->client->addr, .len = sizeof(addr), .buf = addr },
+		{ .addr = ts->client->addr, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+	int i, ret = -EIO;
+
+	/* the controller NAKs now and then while it wakes up from doze */
+	for (i = 0; i < GT9886_I2C_RETRIES; i++) {
+		ret = i2c_transfer(ts->client->adapter, msgs, ARRAY_SIZE(msgs));
+		if (ret == ARRAY_SIZE(msgs))
+			return 0;
+		msleep(20);
+	}
+
+	return ret < 0 ? ret : -EIO;
+}
+
+static int gt9886_write(struct gt9886 *ts, u16 reg, u8 val)
+{
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	int i, ret = -EIO;
+
+	for (i = 0; i < GT9886_I2C_RETRIES; i++) {
+		ret = i2c_master_send(ts->client, buf, sizeof(buf));
+		if (ret == sizeof(buf))
+			return 0;
+		msleep(20);
+	}
+
+	return ret < 0 ? ret : -EIO;
+}
+
+/* The controller NAKs register access while dozing: wake it up first */
+static int gt9886_doze_disable(struct gt9886 *ts)
+{
+	u8 stat;
+	int i, ret;
+
+	ret = gt9886_write(ts, GT9886_REG_DOZE_CTRL, GT9886_DOZE_DISABLE);
+	if (ret)
+		return ret;
+
+	usleep_range(8000, 9000);
+
+	for (i = 0; i < 20; i++) {
+		ret = gt9886_read(ts, GT9886_REG_DOZE_STAT, &stat, 1);
+		if (ret)
+			return ret;
+		if (stat == GT9886_DOZE_CLOSED)
+			return 0;
+
+		if (stat != GT9886_DOZE_DISABLE) {
+			ret = gt9886_write(ts, GT9886_REG_DOZE_CTRL,
+					   GT9886_DOZE_DISABLE);
+			if (ret)
+				return ret;
+		}
+		if (i > 5)
+			gt9886_write(ts, GT9886_REG_COORD, 0);
+		usleep_range(10000, 11000);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static void gt9886_doze_enable(struct gt9886 *ts)
+{
+	gt9886_write(ts, GT9886_REG_DOZE_CTRL, GT9886_DOZE_ENABLE);
+}
+
+static void gt9886_reset(struct gt9886 *ts)
+{
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	msleep(100);
+}
+
+static int gt9886_read_version(struct gt9886 *ts)
+{
+	struct device *dev = &ts->client->dev;
+	u8 buf[GT9886_PRODUCT_VER_LEN];
+	u8 sum;
+	int i, ret = -EIO;
+
+	for (i = 0; i < 5; i++) {
+		int j;
+
+		ret = gt9886_doze_disable(ts);
+		if (!ret) {
+			ret = gt9886_read(ts, GT9886_REG_PRODUCT_VER, buf,
+					  sizeof(buf));
+			gt9886_doze_enable(ts);
+		}
+		if (!ret) {
+			for (sum = 0, j = 0; j < sizeof(buf); j++)
+				sum += buf[j];
+			/* the version block sums to zero; byte 21 is the sensor id */
+			if (!sum && buf[21] != 0xff)
+				break;
+			ret = -EPROTO;
+		}
+		msleep(100);
+	}
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read product version\n");
+
+	dev_info(dev, "GT%.4s, patch %08x, mask %06x, sensor id %u\n",
+		 &buf[9], get_unaligned_be32(&buf[17]),
+		 get_unaligned_be24(&buf[6]), buf[21] & 0x0f);
+
+	return 0;
+}
+
+static void gt9886_handle_request(struct gt9886 *ts)
+{
+	struct device *dev = &ts->client->dev;
+	u8 req;
+
+	if (gt9886_read(ts, GT9886_REG_REQUEST, &req, 1))
+		return;
+
+	switch (req) {
+	case 0x03: /* reset */
+		gt9886_reset(ts);
+		return;
+	case 0x01: /* configuration, not supported */
+		dev_warn_ratelimited(dev, "firmware requests a configuration\n");
+		break;
+	}
+
+	gt9886_write(ts, GT9886_REG_REQUEST, 0);
+}
+
+static irqreturn_t gt9886_irq(int irq, void *data)
+{
+	struct gt9886 *ts = data;
+	u8 *buf = ts->frame;
+	int i, n, len, ret;
+	u8 sum;
+
+	ret = gt9886_read(ts, GT9886_REG_COORD, buf,
+			  GT9886_HEADER_SIZE + GT9886_COORD_SIZE +
+			  GT9886_TRAILER_SIZE);
+	if (ret)
+		return IRQ_HANDLED;
+
+	if (buf[0] & GT9886_EVENT_REQUEST) {
+		gt9886_handle_request(ts);
+		goto ack;
+	}
+
+	/* idle, gesture and status frames: nothing to report, but still ack */
+	if (!(buf[0] & GT9886_EVENT_TOUCH))
+		goto ack;
+
+	n = min_t(int, buf[1] & 0x0f, GT9886_MAX_TOUCHES);
+	len = GT9886_HEADER_SIZE + n * GT9886_COORD_SIZE + GT9886_TRAILER_SIZE;
+	if (n > 1) {
+		ret = gt9886_read(ts, GT9886_REG_COORD, buf, len);
+		if (ret)
+			return IRQ_HANDLED;
+	}
+
+	for (sum = 0, i = 0; i < len; i++)
+		sum += buf[i];
+	if (sum)
+		goto ack;
+
+	for (i = 0; i < n; i++) {
+		const u8 *c = &buf[GT9886_HEADER_SIZE + i * GT9886_COORD_SIZE];
+
+		/* the controller now and then pads a contact with filler bytes */
+		if (get_unaligned_le16(&c[1]) > ts->prop.max_x ||
+		    get_unaligned_le16(&c[3]) > ts->prop.max_y)
+			continue;
+
+		input_mt_slot(ts->input, c[0] & 0x0f);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+		touchscreen_report_pos(ts->input, &ts->prop,
+				       get_unaligned_le16(&c[1]),
+				       get_unaligned_le16(&c[3]), true);
+		input_report_abs(ts->input, ABS_MT_PRESSURE, c[5]);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, c[6]);
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+
+ack:
+	gt9886_write(ts, GT9886_REG_COORD, 0);
+
+	return IRQ_HANDLED;
+}
+
+static void gt9886_power_off(void *data)
+{
+	struct gt9886 *ts = data;
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
+}
+
+static int gt9886_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gt9886 *ts;
+	int ret;
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+
+	ts->client = client;
+	i2c_set_clientdata(client, ts);
+
+	ts->supplies[0].supply = "vdd";
+	ts->supplies[1].supply = "vddio";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ts->supplies), ts->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot get supplies\n");
+
+	ts->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio),
+				     "cannot get reset gpio\n");
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ts->supplies), ts->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable supplies\n");
+
+	ret = devm_add_action_or_reset(dev, gt9886_power_off, ts);
+	if (ret)
+		return ret;
+
+	msleep(20);
+	gt9886_reset(ts);
+
+	ret = gt9886_read_version(ts);
+	if (ret)
+		return ret;
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+
+	ts->input->name = "Goodix GT9886 Touchscreen";
+	ts->input->id.bustype = BUS_I2C;
+
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, 0, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, 0, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_PRESSURE, 0, 255, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+	if (!ts->prop.max_x || !ts->prop.max_y)
+		return dev_err_probe(dev, -EINVAL,
+				     "touchscreen-size-x/y are required\n");
+
+	ret = input_mt_init_slots(ts->input, GT9886_MAX_TOUCHES,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+
+	ret = input_register_device(ts->input);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, gt9886_irq,
+					IRQF_ONESHOT, client->name, ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot request irq\n");
+
+	return 0;
+}
+
+static int gt9886_suspend(struct device *dev)
+{
+	struct gt9886 *ts = dev_get_drvdata(dev);
+
+	disable_irq(ts->client->irq);
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
+
+	return 0;
+}
+
+static int gt9886_resume(struct device *dev)
+{
+	struct gt9886 *ts = dev_get_drvdata(dev);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ts->supplies), ts->supplies);
+	if (ret)
+		return ret;
+
+	msleep(20);
+	gt9886_reset(ts);
+	enable_irq(ts->client->irq);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(gt9886_pm_ops, gt9886_suspend, gt9886_resume);
+
+static const struct of_device_id gt9886_of_match[] = {
+	{ .compatible = "goodix,gt9886" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gt9886_of_match);
+
+static const struct i2c_device_id gt9886_id[] = {
+	{ "gt9886" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, gt9886_id);
+
+static struct i2c_driver gt9886_driver = {
+	.driver = {
+		.name = "goodix-gt9886",
+		.of_match_table = gt9886_of_match,
+		.pm = pm_sleep_ptr(&gt9886_pm_ops),
+	},
+	.probe = gt9886_probe,
+	.id_table = gt9886_id,
+};
+module_i2c_driver(gt9886_driver);
+
+MODULE_DESCRIPTION("Goodix GT9886 I2C touchscreen driver");
+MODULE_LICENSE("GPL");
