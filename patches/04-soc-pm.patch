+/*
+ * SM7250 (lito) UFS PHY. The serdes (COM) and HS-B tables are identical to
+ * SM8150/SM8250; TX/RX/PCS differ and are taken from the downstream
+ * ufs-qmp-v4-lito calibration tables (rate A, 2 lanes). The downstream
+ * header places the TX PWM gear dividers at 0x168..0x174, 0x10 below the
+ * QSERDES_V5 layout, so those four are spelled out as raw offsets.
+ */
+#define QSERDES_SM7250_TX_PWM_GEAR_1_DIVIDER_BAND0_1	0x168
+#define QSERDES_SM7250_TX_PWM_GEAR_2_DIVIDER_BAND0_1	0x16c
+#define QSERDES_SM7250_TX_PWM_GEAR_3_DIVIDER_BAND0_1	0x170
+#define QSERDES_SM7250_TX_PWM_GEAR_4_DIVIDER_BAND0_1	0x174
+
+static const struct qmp_phy_init_tbl sm7250_ufsphy_tx[] = {
+	QMP_PHY_INIT_CFG(QSERDES_SM7250_TX_PWM_GEAR_1_DIVIDER_BAND0_1, 0x06),
+	QMP_PHY_INIT_CFG(QSERDES_SM7250_TX_PWM_GEAR_2_DIVIDER_BAND0_1, 0x03),
+	QMP_PHY_INIT_CFG(QSERDES_SM7250_TX_PWM_GEAR_3_DIVIDER_BAND0_1, 0x01),
+	QMP_PHY_INIT_CFG(QSERDES_SM7250_TX_PWM_GEAR_4_DIVIDER_BAND0_1, 0x00),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_LANE_MODE_1, 0xf5),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_LANE_MODE_3, 0x3f),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_RES_CODE_LANE_OFFSET_TX, 0x06),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_RES_CODE_LANE_OFFSET_RX, 0x09),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_TRAN_DRVR_EMP_EN, 0x0c),
+};
+
+static const struct qmp_phy_init_tbl sm7250_ufsphy_rx[] = {
+	QMP_PHY_INIT_CFG(QSERDES_V5_RX_SIGDET_LVL, 0x24),
